# frozen_string_literal: true

source 'https://rubygems.org'

# Specify your gem's dependencies in robot_lab-audit.gemspec
gemspec

gem 'bundler-audit'
gem 'fasterer'
gem 'flay'
gem 'flog'
gem 'irb'
gem 'racc'
gem 'rake', '~> 13.0'
gem 'reek'
gem 'rubocop'

gem 'minitest', '~> 5.16'
gem 'minitest-reporters'
gem 'simplecov', require: false

gem 'ractor_queue'
gem 'robot_lab', path: '../robot_lab'
